# Kopieer naar .env.local voor lokale ontwikkeling.

# Postgres-connectiestring (Neon). Gebruik de "pooled" connectiestring
# (bevat meestal "-pooler" in de hostnaam) — die is geschikt voor zowel
# lokaal gebruik als voor serverless functions op Vercel. Dit is de URL
# die de app zelf gebruikt om te draaien.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Optioneel maar aanbevolen: de "direct"/ongepoolde connectiestring (zónder
# "-pooler" in de hostnaam). Wordt alleen gebruikt door `prisma migrate
# deploy`/`migrate dev` — migraties gebruiken een advisory lock die niet
# betrouwbaar werkt via een pooler. Zonder deze variabele valt de migratie-
# stap terug op DATABASE_URL, wat af en toe een lock-timeout kan geven.
DIRECT_DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Wachtwoord voor de enige-gebruiker login-gate. Stel een sterke waarde in bij deployment.
APP_PASSWORD="verander-mij"
